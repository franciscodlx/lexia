# Copia a .env.local (gitignored). Solo valores públicos del cliente.
# Tras editarlo: npm start -- --reset-cache

# Supabase (Project Settings → API Keys)
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_ANON_KEY=eyJXXXX

# RevenueCat (test_… para la Test Store; appl_… / goog_… en producción)
REVENUECAT_IOS_KEY=appl_XXXX
REVENUECAT_ANDROID_KEY=goog_XXXX

# AdMob rewarded ad units (vacío = Test IDs). Los App IDs van en app.json.
ADMOB_REWARDED_IOS=
ADMOB_REWARDED_ANDROID=
