# Secretos de las Edge Functions (Meta Model API / Muse). NUNCA van en la app.
# Local: copia a supabase/functions/.env (gitignored)
# Nube:  npx supabase secrets set --env-file supabase/functions/.env
MODEL_API_KEY=LLM_xxxxxxxxxxxxxxxx
MUSE_BASE_URL=https://api.meta.ai/v1
# muse-spark-1.3 = recomendado; muse-ember-1.0 = ≈12× más barato
MUSE_MODEL=muse-spark-1.3
MUSE_REASONING_EFFORT=low
# Peticiones del Modo IA por usuario y día (cada llamada a Muse cuesta dinero)
DAILY_AI_WORD_LIMIT=40
