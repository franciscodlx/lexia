# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# iOS (native project IS tracked; only build output / pods are ignored)
ios/Pods/
ios/build/
**/xcuserdata/
*.xcworkspace/xcuserdata/
ios/.xcode.env.local

# Android
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/local.properties
*.hprof

# Ruby / CocoaPods
vendor/bundle/

# Supabase CLI local state + function secrets
supabase/.temp/
supabase/.branches/
supabase/functions/.env
